# PC custom sandbox appUid unit tests, independent from AppSpawn_ut
# (own production sources and dedicated appspawn_appuid_mock).

import("//base/startup/appspawn/appspawn.gni")
import("//base/startup/appspawn/modules/sandbox/sandbox.gni")
import("//build/test.gni")

if (!defined(ohos_lite)) {
  # Private configuration for the AppUid test executable.
  appuid_defines = [
    "APPSPAWN_BASE_DIR=\"/data/appspawn_ut\"",
    "APPSPAWN_LABEL=\"APPSPAWN_UT\"",
    "APPSPAWN_TEST",
    "APPSPAWN_CLIENT",
    "APPSPAWN_DEBUG",
    "GRAPHIC_PERMISSION_CHECK",
    # same feature switch as the production libappspawn_common (bundle.json)
    "APPSPAWN_ALLOW_INTERNET_PERMISSION",

    # Route libc calls of production code to the appUid mock for recording.
    "ioctl=AppUidIoctlStub",
    "open=AppUidOpenStub",
    "prctl=AppUidPrctlStub",
    "chown=AppUidChownStub",
    "setresuid=AppUidSetresuidStub",
    "setresgid=AppUidSetresgidStub",
    "setgroups=AppUidSetgroupsStub",
    "mount=AppUidMountStub",
    "umount2=AppUidUmount2Stub",
  ]

  appuid_include_dirs = [
    "${appspawn_path}",
    "${appspawn_path}/common",
    "${appspawn_path}/standard",
    "${appspawn_path}/modules/common",
    "${appspawn_path}/modules/modulemgr",
    "${appspawn_path}/modules/module_engine/include",
    "${appspawn_path}/modules/sysevent",
    "${appspawn_innerkits_path}/client",
    "${appspawn_innerkits_path}/include",
    "${appspawn_innerkits_path}/permission",
    "${appspawn_path}/test/mock/appspawn_appuid_mock",
    "${appspawn_path}/test/unittest",
    "${appspawn_path}/util/include",
  ]

  # Production sources compiled into the AppUid test executable.
  appuid_base_sources = [
    "app_spawn_appuid_test_helper.cpp",
    "${appspawn_path}/common/appspawn_server.c",
    "${appspawn_path}/common/appspawn_trace.cpp",
    "${appspawn_path}/modules/modulemgr/appspawn_modulemgr.c",
    "${appspawn_path}/standard/appspawn_appmgr.c",
    "${appspawn_path}/standard/appspawn_fd_manager.c",
    "${appspawn_path}/standard/appspawn_msgmgr.c",
    "${appspawn_path}/standard/appspawn_service.c",
    "${appspawn_path}/util/src/appspawn_utils.c",
    "${appspawn_path}/util/src/appspawndf_utils.cpp",
  ]

  appuid_base_external_deps = [
    "bounds_checking_function:libsec_shared",
    "cJSON:cjson",
    "c_utils:utils",
    "config_policy:configpolicy_util",
    "eventhandler:libeventhandler",
    "ffrt:libffrt",
    "googletest:gmock_main",
    "hilog:libhilog",
    "hitrace:hitrace_meter",
    "init:libbegetutil",
    "init:seccomp",
  ]

  ohos_unittest("AppSpawn_AppUid_Test") {
    module_out_path = "appspawn/appspawn"
    cflags = [ "-Dprivate=public" ]
    if (appspawn_unittest_coverage) {
      cflags += [ "--coverage" ]
      ldflags = [ "--coverage" ]
      cflags_cc = [ "--coverage" ]
    }

    deps = []
    defines = appuid_defines
    defines += [
      "DEBUG_BEGETCTL_BOOT",
      "GetParameter=AppUidGetParameterStub",
    ]

    include_dirs = [ "${appspawn_path}/test/mock/appspawn_appuid_mock/event" ]
    include_dirs += appuid_include_dirs
    include_dirs += appspawn_sandbox_inc

    sources = appuid_base_sources
    sources += appspawn_sandbox_src
    sources += [
      "${appspawn_path}/interfaces/innerkits/permission/appspawn_mount_permission.c",
      "${appspawn_path}/modules/ace_adapter/appspawn_checkpoint.c",
      "${appspawn_path}/modules/common/appspawn_adapter.cpp",
      "${appspawn_path}/modules/common/appspawn_cgroup.c",
      "${appspawn_path}/modules/common/appspawn_common.c",
      "${appspawn_path}/modules/common/appspawn_custom_config.cpp",
      "${appspawn_path}/modules/common/appspawn_dfx_dump.cpp",
      "${appspawn_path}/modules/common/appspawn_kill_reason.c",
      "${appspawn_path}/modules/common/appspawn_silk.c",
      "${appspawn_path}/modules/sysevent/event_reporter.cpp",
      # Reuse libc support stubs; AppUid assertions use the private mock below.
      "${appspawn_path}/test/mock/app_system_stub.c",
      "${appspawn_path}/test/mock/appspawn_appuid_mock/appspawn_appuid_mock.c",
      "${appspawn_path}/test/mock/appspawn_appuid_mock/appspawn_appuid_parameter_mock.cpp",
      "app_spawn_appuid_checkpoint_test.cpp",
      "app_spawn_appuid_dac_test.cpp",
      "app_spawn_appuid_sandbox_test.cpp",
    ]

    configs = [ "${appspawn_path}:appspawn_config" ]
    external_deps = appuid_base_external_deps
    external_deps += [
      "access_token:libaccesstoken_sdk",
      "access_token:libtokenid_sdk",
      "access_token:libtokensetproc_shared",
      "hisysevent:libhisysevent",
    ]
    if (build_selinux) {
      defines += [ "WITH_SELINUX" ]
      external_deps += [
        "selinux:libselinux",
        "selinux_adapter:libhap_restorecon",
      ]
    }
  }
}
