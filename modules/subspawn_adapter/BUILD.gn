import("//base/startup/appspawn/appspawn.gni")
import("//build/ohos.gni")

if (target_cpu == "arm64" || target_cpu == "x86_64" ||
    target_cpu == "riscv64") {
  subspawn_lib_dir = "lib64"
} else {
  subspawn_lib_dir = "lib"
}

ohos_shared_library("appspawn_subspawn") {
  if (!use_clang_coverage) {
    version_script =
        "${appspawn_path}/modules/common/appspawn_common.versionscript"
  }
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_no_nvcall = true
    cfi_vcall_icall_only = true
    debug = false
  }
  sources = [
    "subspawn_adapter.cpp",
    "subspawn_napi.cpp",
    "subspawn_preload.c",
  ]
  include_dirs = [
    ".",
    "${appspawn_path}/common",
    "${appspawn_path}/standard",
  ]
  deps = [
    "${appspawn_path}/modules/module_engine:libappspawn_module_engine",
    "${appspawn_path}/util:libappspawn_util",
  ]
  defines = []
  external_deps = [
    "ability_runtime:appkit_child_entry",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "access_token:libtokensetproc_shared",
    "bounds_checking_function:libsec_shared",
    "cJSON:cjson",
    "hilog:libhilog",
    "init:libbegetutil",
    "napi:ace_napi",
  ]
  if (appspawn_enable_spm) {
    defines += [ "APPSPAWN_ENABLE_SPM" ]
  }
  if (build_selinux) {
    defines += [ "WITH_SELINUX" ]
    external_deps += [ "selinux:libselinux" ]
  }
  subsystem_name = "${subsystem_name}"
  part_name = "${part_name}"
  install_enable = true
  module_install_dir = "${subspawn_lib_dir}/appspawn/subspawn"
}
